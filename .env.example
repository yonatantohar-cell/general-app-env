# =============================================================================
#  Lead Generation System — configuration
#  Copy to `.env` and fill in. NEVER commit the real .env (it is gitignored).
#      cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. GOOGLE API KEY  (required — the app refuses to boot without it)
# -----------------------------------------------------------------------------
# Cloud Console > APIs & Services > Credentials > Create API key.
# You MUST enable "Places API (New)" — NOT the legacy "Places API", which
# Google no longer allows new projects to enable.
GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# 2. WHAT TO SEARCH FOR
# -----------------------------------------------------------------------------
# Final queries = every CATEGORY combined with every LOCATION.
# 6 categories x 5 locations = 30 queries per run.
# Comma-separated. Keep categories narrow — Google caps each query at ~60 results,
# so "hairdressers in Haifa" harvests far more than "businesses in Israel".
CATEGORIES=מסעדות,בתי קפה,מספרות,מוסכים,עורכי דין,מרפאות שיניים
LOCATIONS=תל אביב,ירושלים,חיפה,רמת גן,הרצליה

# How each query string is assembled from the two lists above.
QUERY_TEMPLATE={category} {location}

# Optional: set this to bypass the category x location matrix entirely and run
# an explicit list of queries instead. Comma-separated. Leave blank to use the matrix.
QUERIES=

# Language and region of the results.
# he = Hebrew business names, en = Latin script. IL biases results to Israel.
LANGUAGE_CODE=he
REGION_CODE=IL

# -----------------------------------------------------------------------------
# 3. SCHEDULE
# -----------------------------------------------------------------------------
# Standard 5-field cron. Default: every Sunday at 02:00.
#   0 2 * * 0   Sundays 02:00        0 2 * * *   every night 02:00
#   0 2 * * 1   Mondays 02:00        0 */6 * * * every 6 hours
CRON_SCHEDULE=0 2 * * 0
CRON_TIMEZONE=Asia/Jerusalem

# Run one harvest immediately on startup instead of waiting for the first
# scheduled fire. Handy for the very first launch; set false for steady state.
RUN_ON_START=true

# -----------------------------------------------------------------------------
# 4. FREE-TIER BUDGET GUARD
# -----------------------------------------------------------------------------
# Because we request phone numbers, every search bills at Google's Enterprise
# SKU: 1,000 free calls/month, then ~$35 per 1,000. One call returns up to 20
# leads, so 950 calls is roughly 19,000 leads/month at zero cost.
# The app hard-stops when this cap is hit and resumes next month. 950 leaves margin.
MONTHLY_CALL_BUDGET=950

# Pages per query (20 results each). Google stops at ~3 pages / 60 results.
MAX_PAGES_PER_QUERY=3

# -----------------------------------------------------------------------------
# 5. DATA QUALITY
# -----------------------------------------------------------------------------
# Drop results that have no phone number. A lead you cannot call is not a lead.
REQUIRE_PHONE=true

# Also mirror the table to data/leads.json for a future dashboard to fetch.
WRITE_JSON_MIRROR=true

# -----------------------------------------------------------------------------
# 6. NETWORK / RESILIENCE  (sensible defaults — usually leave alone)
# -----------------------------------------------------------------------------
REQUEST_TIMEOUT_MS=15000
MAX_RETRIES=4
RETRY_BASE_DELAY_MS=1000
DELAY_BETWEEN_REQUESTS_MS=250

# -----------------------------------------------------------------------------
# 7. LOGGING
# -----------------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
